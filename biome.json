{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "**",
      "!src/routeTree.gen.ts",
      "!**/*.svg",
      "!.bun",
      "!**/.bun",
      "!.agents",
      "!.claude",
      "!.codex",
      "!.cursor",
      "!.gemini",
      "!.continue",
      "!MACHINE.md",
      "!**/MACHINE.md"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
