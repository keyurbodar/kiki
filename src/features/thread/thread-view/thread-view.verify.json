{
  "matrix": {
    "theme": ["default"],
    "scheme": ["dark", "light"]
  },
  "defaults": {
    "maxMismatch": 2
  },
  "targets": [
    {
      "id": "thread-base",
      "route": "/thread/jam_sample",
      "viewport": "1600x1000",
      "capture": {
        "[data-slot=chat-stamp]": [
          "font-size",
          "min-height",
          "color",
          "margin-bottom"
        ],
        "[data-chat-row-id]": ["padding-top", "max-width"]
      },
      "expect": {
        "[data-slot=chat-stamp]": {
          "font-size": "12px",
          "min-height": "28px",
          "margin-bottom": "12px"
        }
      },
      "variants": {
        "default/dark": {
          "frame": "3PIeUOoVrM"
        }
      }
    },
    {
      "id": "thread-pane-diffs",
      "route": "/thread/jam_sample?pane=diffs",
      "viewport": "1600x1000",
      "variants": {
        "default/dark": {
          "frame": "UITzoMhMKk"
        }
      }
    },
    {
      "id": "thread-takeover-clarify",
      "route": "/thread/jam_sample_clarify",
      "viewport": "1600x1000",
      "capture": {
        "[data-slot=clarify-takeover]": [
          "background-color",
          "border-radius",
          "box-shadow",
          "padding-top"
        ],
        "[data-slot=composer]": ["display"]
      },
      "expect": {
        "[data-slot=composer]": {
          "display": "none"
        }
      },
      "variants": {
        "default/dark": {
          "frame": "k_vMRAQnSu"
        }
      }
    },
    {
      "id": "thread-takeover-environment",
      "route": "/thread/jam_sample_environment",
      "viewport": "1600x1000",
      "capture": {
        "[data-slot=request-takeover]": [
          "background-color",
          "border-radius",
          "box-shadow",
          "padding-top"
        ],
        "[data-slot=variable-row]": ["min-height", "font-size"],
        "[data-slot=composer]": ["display"]
      },
      "expect": {
        "[data-slot=composer]": {
          "display": "none"
        }
      },
      "variants": {
        "default/dark": {
          "frame": "xuItmh4KnR"
        }
      }
    }
  ]
}
