{
  "matrix": {
    "scheme": [
      "dark",
      "light"
    ]
  },
  "defaults": {
    "maxMismatch": 2
  },
  "targets": [
    {
      "id": "model-picker-open",
      "route": "/__model-picker",
      "state": "popover open on the composer footer",
      "viewport": "1440x900",
      "steps": [
        [
          "wait",
          "[data-slot=popover-content]"
        ],
        [
          "wait",
          "[data-slot=picker-lab-card]"
        ]
      ],
      "capture": {
        "[data-slot=popover-content]": [
          "width",
          "background-color",
          "border-radius",
          "box-shadow",
          "border-top-width"
        ],
        "[role=listbox]": [
          "max-height",
          "overflow-y"
        ],
        "[role=listbox] [role=option]": [
          "height",
          "font-size",
          "column-gap",
          "padding-left"
        ],
        "[data-slot=picker-lab-card]": [
          "width",
          "background-color",
          "border-radius"
        ],
        "[data-slot=picker-lab-rail]": [
          "width",
          "border-radius"
        ],
        "[data-slot=menu-search-row]": [
          "height"
        ],
        "[data-slot=menu-search-row] input": [
          "height",
          "font-size"
        ]
      },
      "expect": {
        "[data-slot=popover-content]": {
          "width": "320px"
        },
        "[role=listbox]": {
          "max-height": "320px"
        },
        "[role=listbox] [role=option]": {
          "height": "28px",
          "font-size": "14px"
        },
        "[data-slot=picker-lab-card]": {
          "width": "288px"
        },
        "[data-slot=menu-search-row] input": {
          "height": "28px",
          "font-size": "14px"
        }
      }
    },
    {
      "id": "model-picker-hover",
      "route": "/__model-picker",
      "state": "second model row highlighted",
      "viewport": "1440x900",
      "steps": [
        [
          "wait",
          "[data-slot=popover-content]"
        ],
        [
          "hover",
          "[role=listbox] [role=option]:nth-of-type(4)"
        ],
        [
          "wait",
          "[role=listbox] [data-highlighted]"
        ]
      ],
      "capture": {
        "[role=listbox] [data-highlighted]": [
          "background-color",
          "height"
        ]
      }
    },
    {
      "id": "model-picker-trigger",
      "route": "/__model-picker",
      "state": "closed triggers row",
      "viewport": "1440x900",
      "steps": [
        [
          "wait",
          "[aria-label=Model]"
        ]
      ],
      "capture": {
        "[aria-label=Model]": [
          "height",
          "font-size",
          "color",
          "border-radius"
        ]
      }
    }
  ]
}
