{
  "defaults": {
    "maxMismatch": 2
  },
  "matrix": {
    "theme": ["default"],
    "scheme": ["dark", "light"]
  },
  "targets": [
    {
      "id": "sidebar-thread-hover-card",
      "route": "/threads",
      "state": "sidebar thread row hover card open",
      "viewport": "1440x818",
      "steps": [
        ["hover", "[data-sidebar-target=jam_sample_2]"],
        ["wait", "[data-slot=preview-card-content]"]
      ],
      "capture": {
        "[data-slot=preview-card-content]": [
          "width",
          "padding",
          "background-color",
          "border-radius",
          "box-shadow"
        ],
        "[data-slot=thread-preview]": ["width"],
        "[data-slot=pull-preview]": ["width"]
      }
    }
  ]
}
