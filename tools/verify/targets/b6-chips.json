{
  "matrix": {
    "theme": ["default"],
    "scheme": ["dark", "light"]
  },
  "defaults": {
    "maxMismatch": 2
  },
  "targets": [
    {
      "id": "b6-chips-markdown",
      "route": "/__chips",
      "state": "markdown chips",
      "viewport": "1440x900",
      "capture": {
        "[data-panel=markdown]": [],
        "[data-panel=markdown] a": ["color", "text-decoration-line"]
      },
      "expect": {
        "[data-panel=markdown] a": {
          "text-decoration-line": "none",
          "color": "var(--text-link)"
        }
      }
    },
    {
      "id": "b6-chips-pull-hover",
      "route": "/__chips",
      "state": "pull request hover card",
      "viewport": "1440x900",
      "capture": {
        "[data-panel=pull-hover]": [
          "background-color",
          "border-radius",
          "border-width",
          "padding",
          "width",
          "box-shadow"
        ],
        "[data-panel=pull-hover] a": ["background-color", "padding"]
      },
      "expect": {
        "[data-panel=pull-hover]": {
          "background-color": "var(--popover)",
          "border-radius": "var(--radius-overlay)",
          "padding": "12px",
          "width": "384px"
        },
        "[data-panel=pull-hover] a": {
          "padding": "4px 6px"
        }
      }
    },
    {
      "id": "b6-chips-thread-hover",
      "route": "/__chips",
      "state": "thread hover card",
      "viewport": "1440x900",
      "capture": {
        "[data-panel=thread-hover]": [
          "background-color",
          "border-radius",
          "padding",
          "width"
        ]
      },
      "expect": {
        "[data-panel=thread-hover]": {
          "background-color": "var(--popover)",
          "border-radius": "var(--radius-overlay)",
          "padding": "12px",
          "width": "384px"
        }
      }
    },
    {
      "id": "b6-chips-issue-hover",
      "route": "/__chips",
      "state": "issue hover card",
      "viewport": "1440x900",
      "capture": {
        "[data-panel=issue-hover]": [
          "background-color",
          "border-radius",
          "padding",
          "width"
        ]
      },
      "expect": {
        "[data-panel=issue-hover]": {
          "background-color": "var(--popover)",
          "border-radius": "var(--radius-overlay)",
          "padding": "12px",
          "width": "320px"
        }
      }
    },
    {
      "id": "b6-chips-tooltip",
      "route": "/__chips",
      "state": "file tooltip",
      "viewport": "1440x900",
      "capture": {
        "[data-panel=tooltip]": [
          "background-color",
          "border-radius",
          "padding",
          "font-size",
          "font-weight"
        ]
      },
      "expect": {
        "[data-panel=tooltip]": {
          "background-color": "var(--popover)",
          "border-radius": "var(--radius)",
          "padding": "4px 8px",
          "font-size": "12px",
          "font-weight": "500"
        }
      }
    }
  ]
}
