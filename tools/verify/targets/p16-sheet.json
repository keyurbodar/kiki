{
  "matrix": {
    "theme": ["default"],
    "scheme": ["dark", "light"]
  },
  "defaults": {
    "maxMismatch": 100
  },
  "targets": [
    {
      "id": "p16-sheet-settings-nav",
      "route": "/settings/general",
      "state": "settings navigation sheet open on a narrow viewport",
      "viewport": "390x844",
      "steps": [
        ["click", "button[aria-label='Toggle sidebar']"],
        ["wait", "[data-slot=sheet-content]:not([hidden])"]
      ],
      "capture": {
        "[data-slot=sheet-content]": [],
        "[data-slot=sheet-overlay]": []
      },
      "expect": {
        "[data-slot=sheet-content]": {
          "position": "fixed",
          "left": "0px",
          "width": "343.2px",
          "z-index": "350",
          "display": "flex",
          "flex-direction": "column",
          "overflow-y": "auto",
          "border-right-width": "0.5px",
          "background-color": "var(--panel)",
          "box-shadow": "var(--sh-sheet)"
        },
        "[data-slot=sheet-overlay]": {
          "position": "fixed",
          "z-index": "350",
          "background-color": "var(--overlay)"
        }
      }
    }
  ]
}
